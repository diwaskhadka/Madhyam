<Window x:Class="Madhyam.Windows.AddSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a TV source" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">
    <StackPanel Margin="20">
        <TextBlock Text="Madhyam plays your own Xtream Codes account or M3U playlist. It ships with no channels."
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="XtreamMode" Content="Xtream Codes login" IsChecked="True" Foreground="{StaticResource Fg}"
                         Margin="0,0,20,0" Checked="Mode_Changed" />
            <RadioButton x:Name="M3uMode" Content="M3U playlist URL" Foreground="{StaticResource Fg}" Checked="Mode_Changed" />
        </StackPanel>

        <TextBlock Text="Name (optional)" Foreground="{StaticResource Muted}" />
        <TextBox x:Name="NameBox" Margin="0,2,0,10" />

        <StackPanel x:Name="XtreamFields">
            <TextBlock Text="Server, e.g. http://example.com:8080" Foreground="{StaticResource Muted}" />
            <TextBox x:Name="ServerBox" Margin="0,2,0,10" />
            <TextBlock Text="Username" Foreground="{StaticResource Muted}" />
            <TextBox x:Name="UserBox" Margin="0,2,0,10" />
            <TextBlock Text="Password" Foreground="{StaticResource Muted}" />
            <PasswordBox x:Name="PassBox" Margin="0,2,0,10" />
        </StackPanel>

        <StackPanel x:Name="M3uFields" Visibility="Collapsed">
            <TextBlock Text="Playlist URL (http://… .m3u) or a file path" Foreground="{StaticResource Muted}" />
            <DockPanel Margin="0,2,0,10">
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="Browse_Click" />
                <TextBox x:Name="UrlBox" />
            </DockPanel>
        </StackPanel>

        <TextBlock x:Name="Error" Foreground="#FF7A7A" TextWrapping="Wrap" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="16,5" />
            <Button Content="Add source" IsDefault="True" Padding="16,5" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
