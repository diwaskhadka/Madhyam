<Window x:Class="Madhyam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Madhyam" Width="1440" Height="840" MinWidth="960" MinHeight="560"
        Background="{StaticResource Bg}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSide" Width="210" />
            <ColumnDefinition x:Name="ColGroups" Width="250" />
            <ColumnDefinition x:Name="ColItems" Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: source, search, sections, actions -->
        <DockPanel Grid.Column="0" Background="{StaticResource Panel}">
            <StackPanel DockPanel.Dock="Top" Margin="12,12,12,4">
                <TextBlock Text="Madhyam" FontSize="22" Foreground="{StaticResource Accent}" />
                <TextBlock Text="Source" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,2" />
                <ComboBox x:Name="SourceBox" DisplayMemberPath="Name" SelectionChanged="SourceBox_SelectionChanged" />
                <TextBlock Text="Search (Ctrl+F)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,2" />
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="12">
                <Button Content="Add source…" Click="Add_Click" />
                <Button x:Name="RefreshButton" Content="Refresh source" Click="Refresh_Click" />
                <Button x:Name="RemoveButton" Content="Remove source" Click="Remove_Click" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" />
            </StackPanel>
            <ListBox x:Name="SectionList" Margin="4,8" FontSize="15" Background="Transparent"
                     SelectionChanged="SectionList_SelectionChanged" />
        </DockPanel>

        <!-- Categories -->
        <ListBox Grid.Column="1" x:Name="GroupList" Background="#13162A" Padding="4,8"
                 DisplayMemberPath="Label" SelectionChanged="GroupList_SelectionChanged" />

        <!-- Channels / films / series / episodes -->
        <DockPanel Grid.Column="2" Background="{StaticResource Panel}">
            <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
                <Button x:Name="BackToSeries" Content="◀  Back to series" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="BackToSeries_Click" />
                <TextBlock x:Name="ListTitle" FontSize="18" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Status" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
            </StackPanel>
            <ListBox x:Name="ItemList" MouseDoubleClick="ItemList_MouseDoubleClick" KeyDown="ItemList_KeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play" Click="Play_Click" />
                        <MenuItem Header="Add / remove favorite" Click="Favorite_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="40" Background="#2A3366" CornerRadius="4">
                                <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Width="56" Height="40" Stretch="Uniform" Source="{Binding Logo}" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Player -->
        <DockPanel Grid.Column="3" Background="Black">
            <StackPanel x:Name="InfoPanel" DockPanel.Dock="Bottom" Background="{StaticResource Panel}">
                <TextBlock x:Name="NowTitle" FontSize="18" Margin="14,10,14,0" TextTrimming="CharacterEllipsis"
                           Text="Double-click something to play" />
                <TextBlock x:Name="NowInfo" Foreground="{StaticResource Muted}" Margin="14,2,14,4" TextWrapping="Wrap" />
                <Slider x:Name="SeekBar" Margin="14,0,14,2" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                        Visibility="Collapsed" PreviewMouseUp="SeekBar_PreviewMouseUp" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="14,0,14,10" TextWrapping="Wrap"
                           Text="Enter/double-click play · F11 fullscreen (Esc to leave) · Space pause · PgUp/PgDn change channel · Ctrl+←/→ seek 10 s" />
            </StackPanel>
            <vlc:VideoView x:Name="Video" />
        </DockPanel>
    </Grid>
</Window>
