<Window x:Class="Madhyam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Madhyam" Icon="pack://application:,,,/Assets/Madhyam.ico" Width="1480" Height="900" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Fg}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailCol" Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================= navigation rail -->
        <DockPanel Background="{StaticResource Rail}">
            <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/Madhyam-64.png" Width="40" Height="40" Margin="0,0,0,14"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Madhyam" />
                <RadioButton x:Name="NavDashboard" Style="{StaticResource RailButton}" Content="&#xE80F;" ToolTip="Dashboard" Tag="Dashboard" Checked="Nav_Checked" />
                <RadioButton x:Name="NavSearch" Style="{StaticResource RailButton}" Content="&#xE721;" ToolTip="Advanced search (Ctrl+K)" Tag="Search" Checked="Nav_Checked" />
                <RadioButton x:Name="NavFavorites" Style="{StaticResource RailButton}" Content="&#xEB51;" ToolTip="Favorites" Tag="Favorites" Checked="Nav_Checked" />
                <RadioButton x:Name="NavRecent" Style="{StaticResource RailButton}" Content="&#xE81C;" ToolTip="Recently watched" Tag="Recent" Checked="Nav_Checked" />
                <Border Height="1" Width="28" Background="{StaticResource Line}" Margin="0,8" />
                <RadioButton x:Name="NavMovies" Style="{StaticResource RailButton}" Content="&#xE8B2;" ToolTip="Movies" Tag="Movies" Checked="Nav_Checked" />
                <RadioButton x:Name="NavLive" Style="{StaticResource RailButton}" Content="&#xE7F4;" ToolTip="Live TV" Tag="Live" Checked="Nav_Checked" />
                <RadioButton x:Name="NavSeries" Style="{StaticResource RailButton}" Content="&#xE8F1;" ToolTip="Series" Tag="Series" Checked="Nav_Checked" />
                <RadioButton x:Name="NavAdded" Style="{StaticResource RailButton}" Content="&#xE823;" ToolTip="Recently added" Tag="Added" Checked="Nav_Checked" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10" HorizontalAlignment="Center">
                <RadioButton x:Name="NavSettings" Style="{StaticResource RailButton}" Content="&#xE713;" ToolTip="Settings" Tag="Settings" Checked="Nav_Checked" />
            </StackPanel>
            <Grid />
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="62" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================= top bar -->
            <StackPanel Orientation="Horizontal" Margin="12,10,12,4">
                <!-- Playlist switcher -->
                <Border x:Name="PlaylistButton" CornerRadius="12" Background="{StaticResource Card}" Padding="8,0,10,0" Width="250"
                        Cursor="Hand" MouseLeftButtonUp="PlaylistButton_Click" ToolTip="Playlists, playlist info and account info">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Chip}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaylistName" Text="No playlist" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PlaylistCount" Text="Add a source to begin" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="11"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Search pill (compact) -->
                <Border x:Name="SearchPill" Margin="10,0,0,0" CornerRadius="12" Background="{StaticResource Card}" Padding="12,0" Width="460"
                        BorderThickness="1" BorderBrush="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="SectionLabel" Grid.Column="1" Text="Advanced search" FontWeight="SemiBold" FontSize="12.5"
                                   Margin="10,0,12,0" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Column="2">
                            <TextBlock x:Name="SearchHint" Text="Search in this playlist…" Foreground="{StaticResource Muted}" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"
                                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                                     GotKeyboardFocus="SearchBox_Focus" LostKeyboardFocus="SearchBox_Focus" />
                        </Grid>
                        <Button x:Name="SearchClear" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                Width="26" Height="26" Visibility="Collapsed" Click="SearchClear_Click" ToolTip="Clear" />
                        <Border Grid.Column="4" CornerRadius="6" Background="{StaticResource Chip}" Padding="7,2" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="Ctrl+K" FontSize="10.5" Foreground="{StaticResource Muted}" />
                        </Border>
                    </Grid>
                </Border>

                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add a playlist" Click="Add_Click" Margin="8,0,0,0" />
                <TextBlock x:Name="Status" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="520"
                           TextTrimming="CharacterEllipsis" FontSize="12.5" />
            </StackPanel>

            <!-- ============================================= body -->
            <Grid Grid.Row="1" x:Name="Body" Margin="12,6,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColCats" Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Categories (Live / Movies / Series) -->
                <DockPanel x:Name="CatsPanel" Margin="0,0,12,0">
                    <Grid DockPanel.Dock="Top" Margin="8,2,0,8">
                        <TextBlock x:Name="CatsTitle" Text="Categories" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CatSearchBtn" Style="{StaticResource IconButton}" Content="&#xE721;" Width="30" Height="30" FontSize="13"
                                    ToolTip="Search categories" Click="CatSearch_Click" />
                            <Button x:Name="CatSortBtn" Style="{StaticResource IconButton}" Content="&#xE8CB;" Width="30" Height="30" FontSize="13"
                                    ToolTip="Sort categories" Click="CatSort_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE9E9;" Width="30" Height="30" FontSize="13"
                                    ToolTip="Manage categories (show / hide)" Click="CatManage_Click" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="CatFilterBox" DockPanel.Dock="Top" Margin="4,0,4,10" Visibility="Collapsed" CornerRadius="18"
                            Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0" Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatFilterHint" Grid.Column="1" Text="Search categories" Foreground="{StaticResource Muted}" FontSize="13"
                                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                            <TextBox x:Name="CatFilter" Grid.Column="1" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalContentAlignment="Center" FontSize="13" TextChanged="CatFilter_TextChanged" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="GroupList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CategoryItem}"
                             SelectionChanged="GroupList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <Border Grid.Column="1" CornerRadius="9" Background="{StaticResource Chip}" Padding="7,1" Margin="10,0,0,0"
                                            VerticalAlignment="Center" MinWidth="26">
                                        <TextBlock Text="{Binding Count, StringFormat=N0}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ===== Live TV: channel list + player/guide ===== -->
                <Grid x:Name="LiveLayout" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColList" Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel x:Name="ListPanel" Margin="0,0,12,0">
                        <Border DockPanel.Dock="Top" CornerRadius="10" Background="{StaticResource Panel}" Padding="12,6,6,6" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock x:Name="ListTitle" Text="All channels" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,96,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ListCount" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button x:Name="LiveSortBtn" Style="{StaticResource IconButton}" Content="&#xE8CB;" Width="30" Height="30" FontSize="13"
                                            ToolTip="Sort A–Z" Click="LiveSort_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <TextBlock x:Name="ListEmpty" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="6,10" Visibility="Collapsed" />
                            <ListBox x:Name="ItemList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                                     MouseLeftButtonUp="ItemList_MouseLeftButtonUp" KeyDown="ItemList_KeyDown"
                                     SelectionChanged="ItemList_SelectionChanged" ScrollViewer.ScrollChanged="ItemList_ScrollChanged">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Play" Click="Play_Click" />
                                        <MenuItem Header="Add / remove favorite" Click="Favorite_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Chip}" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}" FontSize="13" Foreground="{StaticResource Muted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Logo}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding NowTitle}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                <Grid Margin="0,3,0,0" Visibility="{Binding HasNow, Converter={StaticResource BoolVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding StartText}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}"
                                                                 Margin="8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding EndText}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{Binding StarGlyph}" Tag="{Binding}" Click="Star_Click"
                                                    ToolTip="Favorite" VerticalAlignment="Top" Width="30" Height="30" FontSize="13">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Star}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>

                    <!-- Player + guide -->
                    <Grid x:Name="PlayerPanel" Grid.Column="1" SizeChanged="Players_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="VideoRow" Height="Auto" />
                            <RowDefinition x:Name="GuideRow" Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="LiveCardBox" VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Border x:Name="LiveCardShadow" CornerRadius="18" Background="{StaticResource Panel}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.36" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="LiveCard" CornerRadius="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" Padding="14,10,14,14">
                                <DockPanel>
                                    <Grid x:Name="LiveCardHeader" DockPanel.Dock="Top" Margin="2,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,150,0">
                                            <Border x:Name="LiveBadge" CornerRadius="9" Background="#2622C55E" Padding="8,2" VerticalAlignment="Center"
                                                    Visibility="Collapsed" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                                                    <TextBlock Text="LIVE" FontSize="10.5" FontWeight="Bold" Foreground="#22C55E" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="LiveCardTitle" Text="Live TV" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="LiveCardSub" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="LiveCloseBtn" Style="{StaticResource PillButton}" Click="LiveClose_Click" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Stop playback">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Close player" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border x:Name="LiveVideoFrame" CornerRadius="12" Background="Black" ClipToBounds="True">
                                    <Grid x:Name="LiveVideoBox" Background="Black">
                                        <StackPanel x:Name="VideoHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="{StaticResource Thumb}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Select a channel to start watching" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
                                        </StackPanel>
                                        <Grid x:Name="LiveVideoHost">
                                            <vlc:VideoView x:Name="Video" Visibility="Collapsed">
                                                <!-- Drawn in VLC's overlay window above the video: click = pause, double-click = full screen. -->
                                                <Grid x:Name="VideoOverlay" Visibility="Collapsed" Background="#01000000" Loaded="Overlay_Loaded"
                                                      MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove">
                                                    <Border x:Name="Osd" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" CornerRadius="10"
                                                            Background="#CC000000" Padding="16,8" Visibility="Collapsed" IsHitTestVisible="False">
                                                        <TextBlock x:Name="OsdText" Foreground="White" FontSize="14" />
                                                    </Border>
                                                    <Border x:Name="BigPlay" Width="76" Height="76" CornerRadius="38" Background="#99000000" IsHitTestVisible="False"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock x:Name="BigPlayGlyph" Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border x:Name="PlayerBar" VerticalAlignment="Bottom" Padding="16,40,16,8">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0" />
                                                                <GradientStop Color="#D9000000" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel>
                                                            <Grid x:Name="SeekRow" Margin="4,0">
                                                                <Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1"
                                                                        PreviewMouseUp="SeekBar_PreviewMouseUp" MouseMove="SeekBar_MouseMove" />
                                                                <Border x:Name="SeekTip" CornerRadius="6" Background="#E6000000" Padding="7,2" HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top" Margin="0,-26,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                                                                    <TextBlock x:Name="SeekTipText" Foreground="White" FontSize="11.5" />
                                                                </Border>
                                                            </Grid>
                                                            <Grid x:Name="TimeRow" Margin="6,0,6,2">
                                                                <TextBlock x:Name="TimePos" Foreground="#D9FFFFFF" FontSize="12" />
                                                                <TextBlock x:Name="TimeLen" Foreground="#D9FFFFFF" FontSize="12" HorizontalAlignment="Right" />
                                                            </Grid>
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button x:Name="PlayPause" Style="{StaticResource PlayerButton}" Content="&#xE769;" ToolTip="Play / pause (Space, or click the picture)" Click="PlayPause_Click" />
                                                                    <Button x:Name="Back10Btn" Style="{StaticResource PlayerButton}" ToolTip="Back 10 s (←)" Click="Back10_Click">
                                                                        <Grid Width="24" Height="24">
                                                                <Path Fill="White" Width="24" Height="24" Stretch="None" Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"></Path>
                                                                <TextBlock Text="10" FontFamily="{StaticResource UiFont}" FontSize="7" FontWeight="Bold" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
                                                            </Grid>
                                                                    </Button>
                                                                    <Button x:Name="Fwd10Btn" Style="{StaticResource PlayerButton}" ToolTip="Forward 10 s (→)" Click="Fwd10_Click">
                                                                        <Grid Width="24" Height="24">
                                                                <Path Fill="White" Width="24" Height="24" Stretch="None" Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"><Path.RenderTransform><ScaleTransform ScaleX="-1" CenterX="12" /></Path.RenderTransform></Path>
                                                                <TextBlock Text="10" FontFamily="{StaticResource UiFont}" FontSize="7" FontWeight="Bold" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
                                                            </Grid>
                                                                    </Button>
                                                                    <Button x:Name="NextEpisodeBtn" Style="{StaticResource PlayerButton}" Content="&#xE893;" ToolTip="Next episode" Click="NextEpisode_Click" Visibility="Collapsed" />
                                                                    <Border x:Name="BarLive" CornerRadius="9" Background="#3322C55E" Padding="8,2" VerticalAlignment="Center"
                                                                Margin="10,0,0,0" Visibility="Collapsed">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" />
                                                                <TextBlock Text="LIVE" FontSize="10.5" FontWeight="Bold" Foreground="#4ADE80" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock x:Name="BarTitle" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button x:Name="VodMute" Style="{StaticResource PlayerButton}" Content="&#xE767;" ToolTip="Mute (M)" Click="Mute_Click" />
                                                                    <Slider x:Name="VolumeBar" Style="{StaticResource SeekSlider}" Width="90" Minimum="0" Maximum="100" Value="100"
                                                                            VerticalAlignment="Center" ValueChanged="VolumeBar_ValueChanged" Margin="0,0,8,0" ToolTip="Volume (↑ / ↓)" />
                                                                    <Button x:Name="AudioBtn" Style="{StaticResource PlayerButton}" Content="&#xE8D6;" ToolTip="Audio track and delay" Click="AudioTracks_Click" />
                                                                    <Button x:Name="SubsBtn" Style="{StaticResource PlayerButton}" Content="&#xE7F0;" ToolTip="Subtitles" Click="Subtitles_Click" />
                                                                    <Button x:Name="SpeedBtn" Style="{StaticResource PlayerButton}" Content="&#xEC4A;" ToolTip="Playback speed" Click="Speed_Click" />
                                                                    <Button x:Name="FullBtn" Style="{StaticResource PlayerButton}" Content="&#xE740;" ToolTip="Full screen (F11 or double-click)" Click="Fullscreen_Click" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </vlc:VideoView>
                                        </Grid>
                                    </Grid>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- EPG list (Settings → Programme guide → List) -->
                        <DockPanel x:Name="GuidePanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed" VerticalAlignment="Top">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" HorizontalAlignment="Left" Click="GuidePrev_Click" ToolTip="Previous day" />
                                <TextBlock x:Name="GuideDay" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" HorizontalAlignment="Right" Click="GuideNext_Click" ToolTip="Next day" />
                            </Grid>
                            <TextBlock x:Name="GuideEmpty" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="6,4" TextWrapping="Wrap"
                                       Text="No programme guide for this channel." Visibility="Collapsed" />
                            <ListBox x:Name="GuideList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CardItem}" MaxHeight="340">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource LiveRed}" Padding="7,1" Margin="12,0,0,0"
                                                        Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LiveRed}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0"
                                                         Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                       MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                                       Visibility="{Binding HasDesc, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- EPG timeline ribbon (default) -->
                        <Border x:Name="TimelinePanel" Grid.Row="1" Margin="0,10,0,0" CornerRadius="12" VerticalAlignment="Top"
                                Background="{StaticResource Panel}" Padding="0,8,0,6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="14,0,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TlChannel" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TlNow" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="LiveMute" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mute" Click="Mute_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Full screen (F11)" Click="Fullscreen_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE81D;" ToolTip="Jump to now" Click="TimelineNow_Click" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous day" Click="GuidePrev_Click" />
                                        <TextBlock x:Name="TlDay" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" MinWidth="110" TextAlignment="Center" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next day" Click="GuideNext_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="TlEmpty" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="14,6" Visibility="Collapsed"
                                           Text="No programme guide for this channel." />
                                <ScrollViewer x:Name="TlScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="TlScroll_PreviewMouseWheel">
                                    <Canvas x:Name="TlCanvas" Height="112" HorizontalAlignment="Left" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Movies / Series poster grid ===== -->
                <DockPanel x:Name="GridPanel" Grid.Column="1" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" CornerRadius="12" Background="{StaticResource Panel}" Padding="16,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="GridTitle" Text="All items" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="GridCount" Foreground="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SortBtn" Style="{StaticResource ChipButton}" Click="Sort_Click" ToolTip="Sort">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="SortLabel" Text="Sort: Provider order" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RefineBtn" Style="{StaticResource ChipButton}" Click="Refine_Click" ToolTip="Minimum rating" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="RefineLabel" Text="Refine" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Per page" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,2,0" FontSize="12" />
                                <Button x:Name="Per25" Style="{StaticResource ChipButton}" Content="25" Tag="25" Click="PerPage_Click" />
                                <Button x:Name="Per50" Style="{StaticResource ChipButton}" Content="50" Tag="50" Click="PerPage_Click" />
                                <Button x:Name="Per100" Style="{StaticResource ChipButton}" Content="100" Tag="100" Click="PerPage_Click" />
                                <TextBlock x:Name="PageText" Margin="16,0,6,0" VerticalAlignment="Center" FontSize="12.5" />
                                <Button x:Name="PrevPage" Style="{StaticResource ChipButton}" FontFamily="{StaticResource Icons}" Content="&#xE76B;" Click="PrevPage_Click" />
                                <Button x:Name="NextPage" Style="{StaticResource ChipButton}" FontFamily="{StaticResource Icons}" Content="&#xE76C;" Click="NextPage_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PosterGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="Poster_Click" Cursor="Hand" Margin="0,0,18,22" Width="{DynamicResource PosterW}"
                                            Focusable="False" Foreground="{StaticResource Fg}" ToolTip="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel>
                                                    <Grid Width="{DynamicResource PosterW}" Height="{DynamicResource PosterH}">
                                                        <Border CornerRadius="12" Background="{StaticResource Card}">
                                                            <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Muted}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border CornerRadius="12">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Logo}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <Border x:Name="Hover" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" />
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" CornerRadius="8"
                                                                Background="{StaticResource Badge}" Padding="7,3"
                                                                Visibility="{Binding HasRating, Converter={StaticResource BoolVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                                           Foreground="{StaticResource Rating}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Rating}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                                                           Foreground="{StaticResource Rating}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                                               MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="4,9,4,0"
                                                               Visibility="{DynamicResource PosterTitleVis}" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Hover" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Movie / series page: details, or in-page player + About below ===== -->
                <Grid x:Name="VodPage" Grid.Column="1" Visibility="Collapsed" SizeChanged="Players_SizeChanged">
                    <Border CornerRadius="16" Background="{StaticResource Panel}" ClipToBounds="True">
                        <ContentControl x:Name="VodBackdrop" />
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="VodPlayerRow" Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="VodHeader" Margin="18,14,18,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Esc)" Click="VodBack_Click"
                                        Width="40" Height="40" FontSize="16" />
                                <TextBlock x:Name="VodHeaderTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="900"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Raised player card (16:9 video sized in code). Only the area below scrolls: native video cannot be clipped. -->
                        <Grid x:Name="VodPlayerBox" Grid.Row="1" Margin="18,6,18,14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Border x:Name="VodCardShadow" CornerRadius="18" Background="{StaticResource Panel}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.38" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="VodCard" CornerRadius="18" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" Padding="16,12,16,16">
                                <DockPanel>
                                    <Grid x:Name="VodCardHeader" DockPanel.Dock="Top" Margin="2,0,0,12">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,170,0">
                                            <TextBlock x:Name="VodCardLabel" Text="NOW PLAYING" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                            <TextBlock x:Name="VodCardTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            <TextBlock x:Name="VodCardSub" FontSize="12.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PillButton}" Click="VodClose_Click" ToolTip="Stop and show the details (Esc)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Close player" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="VodVideoFrame" CornerRadius="12" Background="Black" ClipToBounds="True">
                                        <Grid x:Name="VodVideoHost" Background="Black" />
                                    </Border>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <ScrollViewer x:Name="VodScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="VodContent" Margin="34,14,34,30" />
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===== Full-width pages: dashboard, search, favorites, recent, recently added, settings ===== -->
                <ContentControl x:Name="PageHost" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
