<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibraryImport (P/Invoke source generator) marshals byte[] through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Madhyam.exe. Fixed: shortcuts, the installer and the CI checks use this file name. -->
    <AssemblyName>Madhyam</AssemblyName>
    <RootNamespace>Madhyam.Windows</RootNamespace>
    <!-- One version for every platform: the repository VERSION file (docs/RELEASING.md). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <!-- Display name from branding/brand.ini, shared by every platform. Brand.cs reads it back. -->
    <BrandIni>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../branding/brand.ini'))</BrandIni>
    <Product>$([System.Text.RegularExpressions.Regex]::Match('$(BrandIni)', '(?m)^name=(.+?)\s*$').Groups[1].Value)</Product>
    <AssemblyTitle>$(Product)</AssemblyTitle>
    <BrandNativeName>$([System.Text.RegularExpressions.Regex]::Match('$(BrandIni)', '(?m)^native_name=(.+?)\s*$').Groups[1].Value)</BrandNativeName>
    <!-- Rendered from branding/icon.svg by branding/build.py. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- LibVLC for Windows ships x64/x86 only; x64 also runs on Windows on ARM (emulated). -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Publish as one Madhyam.exe (.NET runtime + managed code inside) instead of hundreds of
         loose DLLs. Native DLLs stay beside it on purpose: libvlc.dll must sit next to its plugins
         folder, which breaks if it is packed into the exe (IncludeNativeLibrariesForSelfExtract). -->
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Only ship the 64-bit VLC build; the 32-bit copy is never loaded. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <!-- Package XML docs are not needed next to the exe. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <!-- In-app YouTube trailers (Edge WebView2, preinstalled on Windows 10/11). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <!-- Encrypts the optional OpenSubtitles password for the current Windows user. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-64.png" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BrandNativeName" Value="$(BrandNativeName)" />
  </ItemGroup>

  <!-- One copy of the C# binding, shared with other .NET hosts. -->
  <ItemGroup>
    <Compile Include="..\..\bindings\csharp\MadhyamCore.cs" Link="MadhyamCore.cs" />
  </ItemGroup>

  <!-- The Rust engine must be built first (cargo build, release profile, package madhyam-core-ffi). -->
  <PropertyGroup>
    <IptvNativeDir Condition="'$(IptvNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\target\release\</IptvNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(IptvNativeDir)madhyam_core_ffi.dll" Link="madhyam_core_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckIptvNative" BeforeTargets="Build" Condition="!Exists('$(IptvNativeDir)madhyam_core_ffi.dll')">
    <Error Text="madhyam_core_ffi.dll not found in $(IptvNativeDir). Run: cargo build --release -p madhyam-core-ffi (from the repository root)." />
  </Target>

  <!-- WebView2 also copies loaders for other CPUs into runtimes\; the x64 one already sits beside the exe. -->
  <Target Name="TrimWebView2Runtimes" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes" Condition="Exists('$(PublishDir)WebView2Loader.dll')" />
    <Delete Files="$(PublishDir)Microsoft.Web.WebView2.Core.xml;$(PublishDir)Microsoft.Web.WebView2.WinForms.xml;$(PublishDir)Microsoft.Web.WebView2.Wpf.xml" />
  </Target>

</Project>
